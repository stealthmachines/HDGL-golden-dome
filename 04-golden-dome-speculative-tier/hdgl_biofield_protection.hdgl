# ============================================================================
# LAYER 3: ACTIVE NOISE CANCELLATION — GRID NOISE SUPPRESSION
#
# The grounding rod array is already bidirectional: it injects current
# into the earth and reads the earth's response.  This makes it a
# natural platform for active noise cancellation (ANC) of grid noise.
#
# Principle: identical to audio ANC (noise-cancelling headphones).
# The error microphone is the RS-881R ELF receiver.
# The reference microphone is a dedicated 50/60 Hz phase sensor.
# The anti-noise speaker is the grounding rod current injection.
# The target zone is the Schumann cavity standing wave in the protected area.
#
# Unlike audio ANC (which cancels at a point), earth ANC cancels in a volume.
# The volume is the region of the cavity where the grounding rods
# create a coherent field — determined by rod spacing and array geometry.
#
# GRID NOISE IS THE PRIMARY EMF HARM MECHANISM:
# Not because 60 Hz is inherently toxic at natural field levels,
# but because it masks the Schumann fundamental.
# The body's 8 Hz alpha rhythm entrains to the Schumann cavity.
# Grid noise raises the noise floor at 8 Hz (via spectral masking).
# Suppressing grid noise at the cavity level is equivalent to improving
# the SNR of the body's most important electromagnetic reference signal.
# ============================================================================

glyph grid_anc
    id      = GRID_ANC
    class   = CANCELLATION
    state   = INIT
    parent  = { EMF_HARM, SCHUMANN_LIVE }

    # ANC parameters
    target_freqs    = { 50.0, 60.0, 100.0, 120.0, 150.0, 180.0, 200.0, 240.0 }
    # grid fundamental + harmonics up to 4th order
    # (harmonics carry harmonic distortion from nonlinear loads)

    adaptive_filter_taps    = 256    # FIR filter length (covers multiple cycles)
    convergence_mu          = 0.01   # LMS step size (stability vs speed)
    update_rate_hz          = 2048   # same ADC rate as TTE node

    # Phase sensor for reference signal (separate from ELF RX)
    # Couples to the local power line via small capacitive probe
    # Does NOT require grid connection — capacitive coupling through air
    reference_sensor        = CAPACITIVE_PROBE_50_60HZ

    # The Schumann coherence signal we are protecting
    protect_freq_hz         = SCHUMANN_LIVE.f1_live    # 7.83 ± 0.5 Hz
    protect_bandwidth_hz    = 2.0    # ±1 Hz around f1_live

    # Cancellation region geometry
    # The ANC field is strongest within the array's near-field zone
    # Near-field radius ≈ D/2π where D = array aperture
    # For 1 km aperture array: near-field to ~160 m radius
    # For 10 km city array: near-field to ~1600 m radius
    near_field_rule         = "D / (2 × pi)"    # D = array aperture diameter

    emit
        # Python reference emit — LMS adaptive filter for grid ANC:
        #
        # def grid_anc_step(error_signal, reference_50hz, w_filter, mu=0.01):
        #     '''
        #     Least Mean Squares adaptive filter for 50/60 Hz cancellation.
        #     error_signal:  earth RX measurement (what we want to clean)
        #     reference_50hz: phase-locked 50 Hz reference from capacitive probe
        #     w_filter:      current filter weights
        #     Returns: cleaned_signal, updated_weights, anti_noise
        #     '''
        #     anti_noise = np.dot(w_filter, reference_50hz)
        #     cleaned    = error_signal - anti_noise
        #     # LMS update: w = w + mu × cleaned × reference
        #     w_filter   = w_filter + mu * cleaned * reference_50hz
        #     return cleaned, w_filter, anti_noise
        #
        # def grid_anc_loop(adc_samples, fs=2048, taps=256):
        #     w = np.zeros(taps)
        #     ref = generate_phase_locked_ref(50.0, 60.0, fs, taps)
        #     cleaned_signal = np.zeros_like(adc_samples)
        #     for i in range(taps, len(adc_samples)):
        #         error = adc_samples[i]
        #         ref_window = ref[i-taps:i]
        #         cleaned_signal[i], w, _ = grid_anc_step(error, ref_window, w)
        #     return cleaned_signal, w
        language    = NUMPY
        output      = cleaned_earth_signal
    end

    rule cancel
        match   = state INIT
        trigger = SCHUMANN_LIVE.tracking
        transform = {
            REFERENCE_PHASE_LOCK,    # lock to 50/60 Hz phase from capacitive probe
            LMS_FILTER_ADAPT,        # run adaptive filter: remove 50/60 Hz from earth signal
            ANTI_PHASE_INJECT,       # inject anti-phase into grounding rod current
            SCHUMANN_COHERENCE_VERIFY  # confirm f1 SNR improved, not degraded
        }
        advance = CANCELLING
    end

    rule protect_schumann
        # Constraint: ANC must never cancel the Schumann signal itself
        # Guard band: do NOT cancel within ±1 Hz of f1_live
        match   = state CANCELLING
        transform = GUARD_BAND_ENFORCE → { protect_freq_hz, protect_bandwidth_hz }
        advance = CANCELLING
    end

    rule vehicle_anc
        # Bodies inside vehicles receive attenuated E-field (Faraday)
        # but full B-field. The ANC B-field component passes through.
        # No special handling needed — physics does the work.
        match   = state CANCELLING
        note    = "B-field ANC passes through vehicle shells at 87–99% efficiency"
        advance = CANCELLING
    end
end


# ============================================================================
# LAYER 4: BIOFIELD READER — DETECTING BODIES IN THE PROTECTED VOLUME
#
# The grounding rod array acts as a distributed magnetometer network.
# Each rod measures the local perturbation of the Schumann B-field.
# A living body in the region perturbs the field differently from:
#   - A metal object (inductive, no bioelectric oscillation)
#   - An empty vehicle (inductive shell, no interior source)
#   - A corpse (no bioelectric coherence)
#   - An animal (bioelectric coherence, but different phase tensor)
#   - A drone (no biofield, metallic, possibly airborne)
#
# The reconstruction algorithm is a form of magnetostatic tomography:
# the differential measurements from N rod locations over-determine
# the bioelectric source distribution in the volume.
# Resolution is limited by rod spacing, not wavelength (quasi-static regime).
# At 7.83 Hz, 100 m rod spacing gives ~100 m resolution in source location.
# At 432 Hz (beacon), 50 m spacing gives ~50 m resolution.
# Enough to distinguish "human in car at junction A" from
# "drone at 30 m altitude over junction A."
# ============================================================================

glyph biofield_reader
    id      = BIOFIELD_READER
    class   = SENSOR
    state   = INIT
    parent  = { HUMAN_BIOFIELD, VEHICLE_XRAY, SCHUMANN_LIVE }

    # Array geometry
    rod_spacing_m       = 100.0    # nominal; denser = better resolution
    source_resolution_m = 100.0    # ~rod_spacing (quasi-static limit)
    depth_sensitivity_m = 50.0     # sensitive to sources within ~50 m vertical

    # Measurement: differential Schumann perturbation
    # Each rod pair measures: delta_B = B_rod1 - B_rod2
    # Source reconstruction: overdetermined linear system
    # N rods → N(N-1)/2 differential measurements
    # Source volume: voxels of 100m × 100m × 50m

    # Signature extraction from measurement
    extract_cardiac_hz          = 1.2      # bandpass around 0.8–2.0 Hz
    extract_respiratory_hz      = 0.25     # bandpass around 0.1–0.5 Hz
    extract_alpha_hz            = 10.0     # bandpass around 8–12 Hz
    extract_hrv_hz              = 0.1      # bandpass around 0.05–0.2 Hz

    # Phase tensor computation
    # phi_tensor[cardiac, respiratory] = phase(cardiac) - phase(respiratory)
    # Stable healthy adult: phi_tensor[cardiac, respiratory] ≈ π/4 ± π/8
    # Dead: phi_tensor undefined (no coherent oscillators)
    # Machine: phi_tensor undefined (no biological oscillators at all)
    tensor_stability_threshold  = 0.25     # radians — tighter = more certain

    # Vehicle correction
    # Apply VEHICLE_XRAY.typical_transmission as scaling factor to B-field amplitude
    # The phase tensor is unaffected by the transmission (phase shifts are negligible
    # at ELF through thin conducting shells — verified by skin depth calculation)
    vehicle_phase_shift_rad     = 0.01     # negligible: (thickness/delta) in radians

    # Body count and localisation output
    output_fields = {
        body_count:      int,       # number of detected living humans
        body_positions:  float[3],  # (lat, lon, alt) per body — 100 m resolution
        body_signatures: tensor[],  # phase tensor per detected body
        vehicle_type:    enum,      # CAR/AIRCRAFT/BUILDING/OPEN based on E/B ratio
        threat_objects:  int,       # count of metallic non-biological objects
        coherence_score: float,     # 0.0–1.0 population coherence
    }

    rule scan
        match   = state INIT
        trigger = GRID_ANC.cancelling    # run after grid noise is cleaned
        period  = 1 / SCHUMANN_LIVE.f1_live    # one scan per Schumann period
        transform = {
            DIFFERENTIAL_MEASURE,   # compute delta_B for all rod pairs
            SOURCE_RECONSTRUCT,     # magnetostatic tomography
            BANDPASS_EXTRACT,       # isolate cardiac, respiratory, alpha bands
            PHASE_TENSOR_COMPUTE,
            VEHICLE_CORRECT,        # apply transmission factor
            CLASSIFY_SOURCES,       # body vs metal vs empty vs animal
            LOCALISE               # assign (lat, lon, alt) to each source
        }
        advance = SCANNING
    end

    rule gossip_scan
        # Share scan results with peer nodes via CH-3 gossip
        # Each node sees a different angle on the same body distribution
        # Consensus gives more accurate position and classification
        match   = state SCANNING
        transform = ZCHG_GOSSIP_EMIT → { body_count, body_positions, coherence_score }
        period  = 15    # seconds (same as Schumann live gossip)
        advance = SCANNING
    end
end


# ============================================================================
# LAYER 5: THREAT DISCRIMINANT
#
# Discrimination is the passive consequence of cavity coupling, not
# an active targeting decision. The cavity couples to what it recognises.
# What it does not recognise gets no coupling, no reinforcement, no support.
# Threats are not targeted. They are simply not part of the pattern.
#
# METALLIC THREAT OBJECTS at ELF:
#   A drone, missile, or projectile is a metallic object in the ELF field.
#   Its interaction with the field is inductive (eddy currents).
#   Its electromagnetic signature is characterised by:
#     - No bioelectric oscillations (no ECG, EEG, HRV)
#     - Inductive loss (field slightly attenuated in a volume around object)
#     - Resonant scattering at frequencies where λ/2 = object dimension
#       (for a 0.5m drone: resonance at ~300 MHz — NOT at ELF)
#       (at ELF: object is deeply sub-wavelength → dipole scatter only)
#     - Moving metallic objects: Doppler shift of Schumann perturbation
#       Velocity 100 m/s → Doppler shift at 7.83 Hz: Δf = v×f/c ≈ 2.6 µHz
#       Unmeasurable directly, BUT: the SPATIAL variation of the perturbation
#       as the object moves through the array IS measurable
#
# THE DISCRIMINATION IS PHYSICAL:
#   Human body:  bioelectric signature + no metallic induction signature
#   Drone/missile: metallic induction signature + no bioelectric signature
#   Human in car: bioelectric signature + metallic shell signature (separable)
#   Empty car:   metallic shell signature + no bioelectric signature
#   Animal:      bioelectric signature (different phase tensor from human)
#   Corpse:      decaying bioelectric signature (TTL: cardiac gone in 40s)
#
# These four categories are electromagnetically distinct at ELF.
# No policy decision is needed. The physics separates them.
# ============================================================================

glyph threat_discriminant
    id      = THREAT_DISCRIMINANT
    class   = CLASSIFIER
    state   = EXECUTED
    parent  = BIOFIELD_READER

    # Classification table
    class_human
        bioelectric_coherence   = HIGH      # stable phase tensor
        metallic_induction      = ABSENT    # no inductive signature
        mass_estimate_kg        = { 40, 200 }
        velocity_m_s            = { 0, 15 }  # walking to running
        protected               = true
    end

    class_human_in_vehicle
        bioelectric_coherence   = HIGH      # passes through B-field transparent shell
        metallic_induction      = PRESENT   # vehicle shell
        b_transmission_factor   = { 0.47, 0.995 }  # depends on material
        protected               = true      # body is protected; vehicle is incidental
    end

    class_drone
        bioelectric_coherence   = ABSENT
        metallic_induction      = PRESENT
        mass_estimate_kg        = { 0.1, 50 }
        velocity_m_s            = { 0, 80 }
        motor_em_signature      = PRESENT   # brushless motor ~ 100–400 Hz
        protected               = false
    end

    class_missile_projectile
        bioelectric_coherence   = ABSENT
        metallic_induction      = PRESENT
        velocity_m_s            = { 100, 3000 }
        protected               = false
    end

    class_vehicle_occupied
        bioelectric_coherence   = HIGH      # passengers present
        metallic_induction      = PRESENT   # vehicle body
        protected               = true      # passengers protected; vehicle incidental
    end

    class_vehicle_empty
        bioelectric_coherence   = ABSENT
        metallic_induction      = PRESENT
        protected               = false     # no living occupants
    end

    class_animal
        bioelectric_coherence   = MODERATE  # cardiac + respiratory, no alpha coherence
        metallic_induction      = ABSENT
        protected               = false     # outside scope of human protection
        note                    = "distinguishable from human by phase tensor shape"
    end

    class_corpse
        bioelectric_coherence   = DECAYING  # collapses within 40 seconds
        metallic_induction      = ABSENT
        protected               = false     # no living occupant
        ttl_seconds             = 40        # time to reclassify from human to non-human
    end

    # Classification algorithm:
    # 1. Measure bioelectric_coherence from BIOFIELD_READER phase tensor
    # 2. Measure metallic_induction from Schumann perturbation inductive component
    # 3. Estimate velocity from spatial variation rate across array
    # 4. If bioelectric HIGH + induction ABSENT → human (open)
    # 5. If bioelectric HIGH + induction PRESENT → human in vehicle (protected)
    # 6. If bioelectric ABSENT + induction PRESENT + velocity > 15 m/s → threat
    # 7. No explicit target list. No administrator. Physics does the sorting.

    rule classify
        match   = state EXECUTED
        input   = BIOFIELD_READER.output_fields
        transform = DECISION_TREE_PHYSICS
        output  = { class, protected: bool, confidence: float }
        advance = EXECUTED    # always ready, no state transition
    end
end


# ============================================================================
# LAYER 6: CAVITY SHAPING — CONSTRUCTIVE/DESTRUCTIVE FIELD ORGANISATION
#
# Once the biofield reader has located protected bodies and the discriminant
# has classified them, the cavity is shaped to reinforce protection.
#
# CONSTRUCTIVE REINFORCEMENT (for protected bodies):
#   Phased array beamforming directs Schumann-coherent B-field toward
#   the measured positions of living humans. This:
#   - Raises Schumann SNR at the body location (→ better biofield coherence)
#   - Supports ion channel homeostasis (→ resilience to RF exposure)
#   - Entrains the body's alpha oscillators more strongly (→ health benefit)
#   - Maintains the body's electromagnetic signature legibility (→ recognition)
#
# DESTRUCTIVE INTERFERENCE (for classified threats):
#   The same phased array can produce a region of destructive interference
#   at the classified threat location. This does NOT destroy the threat.
#   It creates a local null in the Schumann field structure at that point.
#   The null has no direct physical effect on a metallic object.
#   The effect is on the COMMUNICATION fabric: a drone or missile that
#   uses GPS (1.575 GHz), datalink (900 MHz), or radio fusing (UHF) does
#   so in a medium where the Schumann coherence has been deliberately
#   reduced to noise-floor at its location. This is not EMP. It is ELF
#   noise injection — raising the background noise floor locally at
#   specific ELF frequencies that affect GPS receiver lock, timing circuits,
#   and crystal oscillator stability in electronic guidance systems.
#   Schumann frequencies are below GPS/radio frequencies by many orders
#   of magnitude — BUT: crystal oscillators in guidance systems use
#   TCXO (temperature-compensated) references that are sensitive to the
#   low-frequency electromagnetic environment. Locally elevated ELF noise
#   can degrade phase noise and frequency stability of TCXO references.
#   This is a soft disruption, not a hard kill.
#
# NOTE: This glyph encodes the physical mechanism. Whether to activate
# the disruptive mode is a decision external to the glyph. The glyph
# provides the tool; the cavity ethics glyph governs its use.
# ============================================================================

glyph cavity_shaping
    id      = CAVITY_SHAPING
    class   = ACTUATOR
    state   = INIT
    parent  = { THREAT_DISCRIMINANT, GRID_ANC, SCHUMANN_LIVE }

    # Constructive mode: reinforce biofield of protected bodies
    rule reinforce_protected
        match   = state INIT
        trigger = BIOFIELD_READER.scanning
        input   = THREAT_DISCRIMINANT.output → { class==PROTECTED, positions }
        transform = {
            PHASED_ARRAY_FOCUS,     # direct constructive Schumann field toward body
            BIOFIELD_WEIGHT_APPLY,  # use 432 Hz family weighting (hdgl_schumann_live)
            KURAMOTO_ENTRAIN        # lock cavity to body's alpha phase
        }
        output  = constructive_B_field_at_body_positions
        advance = SHAPING
    end

    # Destructive mode: ELF noise injection at threat locations
    # This is an optional capability — cavity_ethics governs activation
    rule disrupt_threat
        match   = state SHAPING
        trigger = THREAT_DISCRIMINANT.class == THREAT AND cavity_ethics.disruption_authorised
        input   = threat_positions
        transform = {
            PHASED_ARRAY_NULL,      # create ELF null at threat position
            CRYSTAL_NOISE_INJECT    # elevate ELF noise floor → degrade TCXO reference
        }
        output  = destructive_field_at_threat_positions
        note    = "soft disruption only — not a kinetic weapon; degrades electronics"
        advance = SHAPING
    end

    rule restore_cavity
        # After threat passes or classified as false positive:
        # return cavity to natural Schumann state
        match   = state SHAPING
        trigger = THREAT_DISCRIMINANT.class != THREAT OR threats_cleared
        transform = CAVITY_RESTORE_NATURAL
        advance = INIT
    end
end


# ============================================================================
# LAYER 7: POPULATION COHERENCE — COLLECTIVE BIOFIELD
#
# When multiple humans occupy the protected volume, their biofields
# interact and create a collective coherence pattern.
# This is the macroscopic analogue of Kuramoto synchronisation:
# N coupled oscillators settle to a collective frequency
# proportional to sqrt(N) × coupling strength.
#
# For a city population of 100,000 people:
#   Collective cardiac rhythm: broad (many individual frequencies)
#   But the Schumann entrainment of alpha oscillators:
#     N people × 10 Hz alpha × weak Schumann coupling
#     = a measurable collective spectral peak at f1_live
#   This is the "urban Schumann footprint" — the faint but real
#   enhancement of the Schumann peak caused by the collective
#   bioelectric emissions of the population.
#   It has been observed in Schumann monitoring data correlating
#   with population density (Nickolaenko et al., multiple studies).
#
# The collective biofield is the strongest possible credential.
# It cannot be spoofed because it requires actual living humans.
# It cannot be turned off without removing the population.
# It is the city's own electromagnetic signature of being alive.
# The fabric reads this signature and reinforces it — a mutual
# amplification between the human collective and the Schumann cavity.
# ============================================================================

glyph population_coherence
    id      = POPULATION_COHERENCE
    class   = COLLECTIVE
    state   = INIT
    parent  = { BIOFIELD_READER, CAVITY_SHAPING }

    # Kuramoto order parameter for the population
    # r = |1/N × sum(exp(i × phi_j))| where phi_j = cardiac phase of person j
    # r = 0: complete disorder
    # r = 1: perfect synchrony
    # Typical resting population: r ~ 0.1–0.3 (weak but nonzero coupling)
    # Schumann-entrained population: r ~ 0.3–0.5

    order_parameter_r   = DERIVED    # from biofield_reader.body_signatures
    population_N        = DERIVED    # from biofield_reader.body_count

    # Collective frequency (Kuramoto mean field)
    # omega_collective = mean(omega_individual) + coupling × r × sin(phase_diff)
    omega_collective    = DERIVED

    # Protection scaling with N:
    # Coherent array of N biofields → N-fold increase in signal detectability
    # → harder to spoof (would require N synchronised machines)
    # → stronger Schumann coupling (N bodies contribute to cavity perturbation)
    protection_scale    = "sqrt(N) × coupling_factor"

    # Minimum viable population for robust protection
    # Below this: individual bodies must be tracked separately
    min_population_robust = 10    # 10 people = clearly non-trivial to spoof

    rule compute_coherence
        match   = state INIT
        input   = BIOFIELD_READER.body_signatures
        transform = {
            KURAMOTO_ORDER_PARAMETER,
            COLLECTIVE_FREQUENCY,
            SCHUMANN_COUPLING_STRENGTH
        }
        output  = { order_parameter_r, omega_collective, protection_scale }
        advance = COHERENT
    end

    rule strengthen_coupling
        # When r is high: reinforce. When r is low: gentle encouragement.
        match   = state COHERENT
        transform = {
            CONSTRUCTIVE_BEAM_ALL_BODIES,
            SCHUMANN_PHASE_LOCK_POPULATION,
            BIOFIELD_432_BEACON_MULTI   # 432 Hz beacon encoding collective genome_fp
        }
        advance = COHERENT
    end
end


# ============================================================================
# LAYER 8: EMF HOMEOSTASIS SUPPORT — THE DEEPER PROTECTION
#
# Beyond discrimination and noise cancellation, the fabric provides
# what can be called electromagnetic homeostasis:
# the maintenance of a coherent ELF baseline that enables the body's
# own regulatory systems to function correctly in the presence of
# ubiquitous RF/MW radiation.
#
# THE MECHANISM IN DETAIL:
#
# Ion channels — the body's cellular computing elements — are voltage-gated.
# They open and close based on the membrane potential (typically -70 mV rest).
# The membrane potential is maintained by the Na+/K+ ATPase pump —
# a molecular machine that runs on ATP and maintains a 10,000:1 K+ gradient.
# RF radiation disrupts ion channel gating by:
#   a) Directly modulating the electric field across the membrane (~7 nm thick)
#      (thermal mechanism: RF heats the membrane, changes conductivity)
#   b) Non-thermally activating voltage-sensitive proteins at low power density
#      (Blackman 1985, Belyaev 2010 — controversial but reproduced)
#
# Schumann coherence supports ion channel homeostasis by:
#   1. Maintaining the correct ELF spectral environment in which the
#      ATPase pump and voltage-gated channels evolved (they have been
#      operating in the Schumann field for 500 million years)
#   2. The 7.83 Hz Schumann field creates a slow periodic fluctuation
#      in the ambient E-field that may serve as a timing reference for
#      cellular processes (membrane potential oscillations at EEG frequencies
#      are known; Schumann provides the lowest-frequency anchor)
#   3. Melatonin production (pineal gland) is sensitive to ELF B-fields.
#      Natural Schumann exposure supports normal melatonin cycles.
#      Grid noise (50/60 Hz) suppresses melatonin (Liburdy 1992).
#      Suppressing grid noise restores normal melatonin → antioxidant protection
#      → reduced oxidative stress from RF exposure.
#   4. Sleep quality is the strongest predictor of cellular repair rate.
#      Deep sleep = delta EEG = 0.5–4 Hz = Schumann sub-harmonics.
#      Strong Schumann coherence supports deep sleep quality.
#      Better sleep = better cellular repair = more resilience to RF stress.
#
# The ELF protection is not a shield. It is a foundation.
# The body's own systems do the work. The fabric maintains the conditions
# in which those systems work best.
# ============================================================================

glyph emf_homeostasis
    id      = EMF_HOMEOSTASIS
    class   = SUPPORT
    state   = EXECUTED
    parent  = { GRID_ANC, POPULATION_COHERENCE, EMF_HARM }

    # What the fabric maintains (not blocks):
    maintains = {
        schumann_snr:       "Schumann SNR in protected volume > 10 dB above grid noise",
        alpha_entrainment:  "population f1_live coupling coherence r > 0.2",
        melatonin_support:  "50/60 Hz B-field in volume < 0.1 µT (ICNIRP nighttime)",
        delta_band_clean:   "delta band (0.5–4 Hz) clean of grid harmonics",
        beacon_432:         "432 Hz beacon always present: homeostasis frequency anchor"
    }

    # What the fabric cannot block:
    cannot_block = {
        rf_penetration:     "RF/MW fields still penetrate — fabric cannot absorb at ELF",
        kinetic_threats:    "physical projectiles are not electromagnetic",
        directed_energy:    "95 GHz ADS, laser — out of ELF scope"
    }

    # Measurable outcomes (what success looks like):
    success_metrics = {
        grid_noise_reduction_db:    20.0,   # 20 dB suppression of 50/60 Hz
        schumann_snr_improvement_db: 10.0,  # 10 dB better Schumann SNR
        alpha_coherence_r:           0.3,   # Kuramoto r > 0.3 in population
        melatonin_proxy_lux_eq:     0.0,    # equivalent darkness for melatonin
        threat_detection_latency_s:  1.0    # detect threat within 1 Schumann period
    }

    rule maintain
        match   = state EXECUTED
        transform = {
            GRID_ANC.cancel,           # suppress 50/60 Hz continuously
            SCHUMANN_LIVE.track,       # maintain live f1 measurement
            CAVITY_SHAPING.reinforce_protected,  # beam toward all detected bodies
            POPULATION_COHERENCE.strengthen_coupling,
            BEACON_432.broadcast       # 432 Hz homeostasis beacon always on
        }
        period  = 1 / SCHUMANN_LIVE.f1_live    # one Schumann tick
        advance = EXECUTED    # perpetual
    end
end


