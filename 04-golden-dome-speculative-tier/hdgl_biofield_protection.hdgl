# ============================================================================
# LAYER 0: PHYSICAL CONSTANTS FOR TISSUE AND VEHICLES
# ============================================================================

glyph tissue_electrodynamics
    id      = TISSUE_EM
    class   = PHYSICS
    state   = EXECUTED

    # Cole-Cole model parameters for biological tissue at ELF
    # (Gabriel et al. 1996 — canonical reference dataset)
    # sigma_eff(f) at ELF in S/m:
    sigma_muscle_elf    = 0.25     # S/m at 50–60 Hz
    sigma_brain_elf     = 0.10     # S/m
    sigma_blood_elf     = 0.70     # S/m
    sigma_fat_elf       = 0.04     # S/m
    sigma_bone_elf      = 0.02     # S/m
    # epsilon_r at ELF (~10⁶–10⁷, strongly frequency dependent)
    eps_r_muscle_elf    = 1.0e7
    eps_r_brain_elf     = 1.0e7

    # Tissue density (kg/m³)
    rho_tissue          = 1000.0

    # SAR (Specific Absorption Rate):
    # SAR = sigma × |E|² / (2 × rho)   [W/kg]
    sar_rule            = "sigma × E_sq / (2 × rho)"

    # ICNIRP 2020 exposure limits
    icnirp_whole_body_public   = 0.08    # W/kg
    icnirp_head_trunk_public   = 2.0     # W/kg
    icnirp_whole_body_occup    = 0.4     # W/kg

    # Natural Schumann SAR in body:
    # E_schumann ≈ 0.3 mV/m → SAR ≈ sigma × (3×10⁻⁴)² / 2000 ≈ 10⁻¹⁰ W/kg
    sar_natural_schumann        = 1.0e-10   # W/kg (10⁸ × below ICNIRP limit)
    safety_margin_natural       = 8.0e7     # dimensionless

    # Penetration depth in muscle at key frequencies (skin depth model)
    # delta = 1/sqrt(pi × f × mu_0 × sigma)
    penetration_50hz_cm         = 14235.0   # cm — entire body transparent at 50 Hz
    penetration_900mhz_cm       = 5.18      # cm — RF penetrates 5 cm into muscle
    penetration_2450mhz_cm      = 2.24      # cm — WiFi: 2 cm penetration
    penetration_60ghz_cm        = 0.14      # cm — 5G mmWave: skin only
end

glyph vehicle_transparency
    id      = VEHICLE_XRAY
    class   = PHYSICS
    state   = EXECUTED
    parent  = TISSUE_EM

    # B-field skin depth and transmission for common vehicle materials at f₁=7.83 Hz
    # delta = 1/sqrt(pi × f × mu × sigma)
    # transmission = exp(-thickness/delta)

    # Car body panel — mild steel
    steel_sigma         = 1.0e7     # S/m
    steel_mu_r          = 100.0     # relative permeability
    steel_delta_cm      = 0.57      # skin depth at 7.83 Hz (computed: 5.7 mm)
    steel_panel_mm      = 0.8       # typical door panel
    steel_transmission  = 0.869     # 86.9% B-field passes through

    # Aircraft skin — aluminum alloy
    al_sigma            = 3.5e7     # S/m
    al_mu_r             = 1.0       # non-magnetic
    al_delta_cm         = 3.0       # skin depth at 7.83 Hz
    al_skin_mm          = 2.0       # typical fuselage skin
    al_transmission     = 0.936     # 93.6% B-field passes through

    # Carbon fibre reinforced polymer (composites, stealth aircraft)
    cfrp_sigma          = 5.0e4     # S/m (much lower than metals)
    cfrp_delta_cm       = 80.4      # skin depth at 7.83 Hz
    cfrp_thickness_mm   = 4.0
    cfrp_transmission   = 0.995     # 99.5% — essentially transparent

    # Glass, concrete, building materials: 100% transmission at ELF

    # CONCLUSION: all practical enclosures are transparent to B-field at ELF
    # The protected body is fully coupled to the Schumann cavity
    # regardless of whether it is inside a car, aircraft, building, or ship.
    min_b_transmission  = 0.47      # worst case: 3mm high-strength steel chassis
    typical_transmission = 0.90     # car body, aircraft: ~90% transmission
    rule_of_thumb = "body in vehicle = body in open field, electromagnetically"
end


# ============================================================================
# LAYER 1: HUMAN BIOELECTRIC SIGNATURE
#
# The living body is a multi-oscillator phi-lattice.
# The aggregate of its oscillators is its unique electromagnetic credential.
# This credential is:
#   - Continuous (24 hours/day, sleeping or waking)
#   - Dynamic (phase relationships vary with state)
#   - Phase-coherent (oscillators are not independent — ANS couples them)
#   - Irreproducible by machines (requires metabolic energy + ion channels)
#   - Self-revoking on death (collapses within 40 seconds of cardiac arrest)
#   - Vehicle-transparent (B-field passes through all practical enclosures)
# ============================================================================

glyph human_biofield
    id      = HUMAN_BIOFIELD
    class   = CREDENTIAL
    state   = EXECUTED
    parent  = { TISSUE_EM, VEHICLE_XRAY }

    # ── Primary oscillators ──────────────────────────────────────────────
    # Each entry: { frequency_hz, amplitude_unit, source, phi_relationship }

    oscillator_cardiac
        freq_hz     = 1.2         # resting heart rate range: 0.8–2.0 Hz
        amplitude   = "~1 mV ECG surface, ~50 pT MCG B-field at chest"
        phase_ref   = PRIMARY     # all other oscillators phase-reference to this
        phi_note    = "cardiac IBI (inter-beat interval) has 1/f spectrum — same as Schumann"
    end

    oscillator_hrv
        freq_hz     = 0.1         # low-frequency HRV: autonomic balance
        amplitude   = "±15% RR interval modulation"
        phase_ref   = CARDIAC
        phi_note    = "HRV coherence at 0.1 Hz is the vagal tone marker — health indicator"
    end

    oscillator_respiratory
        freq_hz     = 0.25        # resting breath: 12–18/min = 0.2–0.3 Hz
        amplitude   = "~0.5 mV chest impedance signal"
        phase_ref   = CARDIAC
        phi_note    = "breath at 0.1 Hz (6/min) maximises HRV — coherent breathing"
    end

    oscillator_eeg_alpha
        freq_hz     = 10.0        # alpha peak: 8–12 Hz, individual-specific
        amplitude   = "10–100 µV EEG, ~100 fT MEG B-field at scalp"
        phase_ref   = SCHUMANN_LIVE.f1_live    # alpha entrains to Schumann
        phi_note    = "alpha / f1_live ratio = 10.0 / 7.83 = 1.28 ≈ √φ (= 1.272)"
        # This near-φ relationship is not coincidence:
        # both derive from the same class of oscillating systems where
        # energy-optimal frequency ratios cluster around φ and its powers
    end

    oscillator_eeg_theta
        freq_hz     = 6.0         # theta: 4–8 Hz, memory consolidation
        amplitude   = "20–100 µV"
        phase_ref   = SCHUMANN_LIVE.f1_live
        phi_note    = "theta overlaps Schumann f1 band directly"
    end

    oscillator_gut
        freq_hz     = 0.05        # gastric myoelectric: 3 cycles/min
        amplitude   = "~100 µV EGG (electrogastrogram)"
        phase_ref   = CARDIAC
    end

    oscillator_eda
        freq_hz     = 0.03        # electrodermal activity: skin conductance
        amplitude   = "1–20 µS conductance change"
        phase_ref   = RESPIRATORY
    end

    # ── Composite signature ──────────────────────────────────────────────
    # The signature is not any single oscillator but the PHASE TENSOR:
    # a matrix of phase relationships between all oscillator pairs,
    # sampled continuously and compared against the running baseline.
    #
    # phi_tensor[i,j] = phase(oscillator_i) - phase(oscillator_j)
    # Healthy body: phi_tensor is stable within ±15° for all pairs
    # Stressed body: phi_tensor widens but remains coherent
    # Dead body:     phi_tensor collapses to random within 40 seconds
    # Machine:       phi_tensor is undefined (no biological oscillators)
    # Sedated body:  phi_tensor narrows (reduced variability — still coherent)
    # Sleeping body: phi_tensor shifts (delta dominance) — still recognised

    signature_rule = "phase_tensor(cardiac, hrv, respiratory, alpha, theta, gut, eda)"
    signature_update_rate_hz = 10.0    # update 10× per second
    signature_uniqueness     = "unique as fingerprint, derived from physics not policy"
    signature_revocation     = "automatic on cardiac arrest: 40 second TTL"

    # ── Vehicle coupling ─────────────────────────────────────────────────
    # The B-field components of all oscillators pass through vehicle shells.
    # The cardiac B-field (MCG) at chest surface: ~50 pT
    # Through 0.8mm steel: 50 pT × 0.869 = 43.5 pT — still readable
    # Through 2mm aircraft aluminum: 50 pT × 0.936 = 46.8 pT
    # The grounding array reads perturbations of the Schumann field
    # caused by the body — not the body's field directly.
    # This perturbation is independent of vehicle shielding.
    vehicle_coupling = "full — B-field transparent at ELF regardless of enclosure"

    rule read_signature
        match   = state EXECUTED
        input   = grounding_array_differential_measurement
        transform = {
            SCHUMANN_DETREND,       # remove background Schumann carrier
            BIOFIELD_EXTRACT,       # isolate body-induced perturbation
            PHASE_TENSOR_COMPUTE,   # compute phi_tensor from perturbation
            SIGNATURE_COMPARE,      # match against known-good baseline
            VEHICLE_CORRECT         # apply vehicle_xray transmission factor
        }
        output  = { signature_match: bool, coherence: float, vehicle_type: enum }
        advance = READING
    end
end


