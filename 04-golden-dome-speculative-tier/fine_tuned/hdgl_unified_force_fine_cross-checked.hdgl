    class   = IMPLEMENTATION
    state   = EXECUTED
    parent  = { L_OPERATOR, ONE_EFF, LAMBDA_PHI }

    osc_map     = "osc[i] ↔ 𝓛_{n_i}(z)  [8 modes tracked in parallel]"
    phase_map   = "osc.theta[i] = arg(𝓛_{n_i}(z))  [the phase arm of 𝓛]"
    coupling    = "Kuramoto K = inter-mode coherence of 𝓛"

    adaptive_phases
        PLUCK    = "𝓛 far from fixed: |δ| large, K=5.0 γ=0.005 [1000:1 ratio]"
        SUSTAIN  = "𝓛 converging:     δ decreasing, K=3.0 γ=0.008"
        FINETUNE = "𝓛 near fixed:     δ small,      K=2.0 γ=0.010"
        LOCK     = "𝓛 AT fixed:       δ→0, CV<0.05, K=1.8 γ=0.012 [wu-wei]"
    end

    # Phase doubling = LL squaring in 𝓛-space:
    phase_double  = "θ → 2θ  =  sₖ₊₁=sₖ²-2  [LL squaring IS phase doubling on unit circle]"

    # φ-tower fixed point (from ll_analog.c):
    phi_tower     = "U* = φ^(φ^(φ^(Σ sin(θᵢ-θⱼ))))  [nested tower; U*→const as phases lock]"

    # Double confirmation:
    double_confirm = "osc LOCKED + LL residue=0 → both 𝓛 phase and exact arithmetic agree"

    wu_wei         = "do not force lock — remove obstacles, let Ωₙ₊₁=T(Ωₙ) settle"
end


