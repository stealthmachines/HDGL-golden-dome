glyph dn_as_L_first_order
    id      = DN_L
    class   = DERIVED
    state   = EXECUTED
    parent  = { L_OPERATOR, LAMBDA_PHI }

    dn_formula     = "Dₙ(r) = √(φ·Fₙ·2ⁿ·Pₙ·Ω) · r^k"
    L_formula      = "𝓛ₙ(Ω-1) = φ^(-1/φ) · √(Fₙ·Pₙ·2ⁿ) · Ωⁿ"
    reconciliation = "Dₙ ≈ 𝓛ₙ(Ω-1) with Ωⁿ→√Ω and φ^(-1/φ)→√φ"
    precision_gap  = "Dₙ uses √Ω; 𝓛 uses Ωⁿ — difference grows with n"
    update_rule    = "Dₙ(r) → 𝓛ₙ(Ω(f)-1) for full precision"
    rydberg_fix    = "Rydberg 8.66% error: Dₙ first-order; 𝓛 with Ωⁿ resolves it"
end


