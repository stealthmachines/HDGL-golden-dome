# PART II — INTEGRATION MAP
# ════════════════════════════════════════════════════════════════════════════
#
# Six seams. Each is one targeted edit to an existing file, or a drop-in
# replacement. Nothing else in the source zips changes.
#
# SEAM 1 — hdgl_router64.asm: add disk_write + integrate NIC/store/peers
# ─────────────────────────────────────────────────────────────────────────
# After .disk_read, add .disk_write (ATA PIO write, symmetric to read):
#
#   .disk_write:
#       push rax / push rcx / push rdx / push rsi
#       ; device/head (identical to disk_read up to command byte)
#       push rax
#       movzx edx, word [.ata_base]
#       add   edx, 6
#       shr   eax, 24
#       and   al, 0x0F
#       or    al, 0xE0
#       out   dx, al
#       pop   rax
#       push  rax
#       movzx edx, word [.ata_base]
#       add   edx, 2
#       mov   al, cl          ; sector count
#       out   dx, al
#       pop   rax
#       push  rax
#       movzx edx, word [.ata_base]
#       add   edx, 3          ; LBAlo
#       out   dx, al
#       shr   eax, 8
#       inc   edx             ; LBAmid
#       out   dx, al
#       shr   eax, 8
#       inc   edx             ; LBAhi
#       out   dx, al
#       pop   rax
#       movzx edx, word [.ata_base]
#       add   edx, 7
#       mov   al, 0x30        ; WRITE SECTORS command
#       out   dx, al
#   .dw_w:
#       in    al, dx
#       test  al, 0x80        ; BSY
#       jnz   .dw_w
#       test  al, 0x08        ; DRQ
#       jz    .dw_w
#       mov   ecx, 256
#       movzx edx, word [.ata_base]
#       rep   outsw           ; write 512 bytes from [RSI]
#       pop   rsi / pop rdx / pop rcx / pop rax
#       ret
#
# After .omega_execute_compiler (boot sequence end), add one call:
#
#   call .boot_complete_init      ; from hdgl_complete.hdgl
#
# In .sh_dispatch, before the final .sh_unknown fallback, add:
#
#   call .sh_cmd_genome    ; from hdgl_genome_shell.hdgl
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_fabric
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_ftick
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_fgossip
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_nic2      ; from hdgl_complete.hdgl
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_store
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_peers
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_send
#   cmp  eax, 1 / je .sh_loop
#   call .sh_cmd_load
#   cmp  eax, 1 / je .sh_loop
#
# In the phi-bridge mailbox write section, after the existing 104 bytes:
#
#   call .mailbox_extend          ; from hdgl_complete.hdgl (adds +24 bytes)
#
# SEAM 2 — hdgl_router64.asm: include new ASM sources
# ─────────────────────────────────────────────────────────────────────────
# At the bottom of hdgl_router64.asm, before the final padding:
#
#   %include "hdgl_nic.asm"
#   %include "hdgl_genome_shell_emit.asm"   ; assembled from hdgl_genome_shell.hdgl
#   %include "hdgl_complete_emit.asm"       ; assembled from hdgl_complete.hdgl
#
# The HDGL compiler (hdgl_compiler.hdgl, already in the build) handles
# the .hdgl → .asm emit step. The three .hdgl files each have emit blocks
# that produce valid NASM-compatible assembly.
#
# SEAM 3 — zchg_core.h: extend gossip_msg_t
# ─────────────────────────────────────────────────────────────────────────
# Replace the typedef in zchg_core.h with the one from zchg_core_patch.h.
# +8 bytes at the end. Wire-backward-compatible (old senders send 17B; fine).
#
# SEAM 4 — NGINX-HDGL build: replace three files
# ─────────────────────────────────────────────────────────────────────────
# Replace in NGINX-HDGL-0.6-c/src/:
#   zchg_frame.c    → zchg_frame_patched.c   (rename to zchg_frame.c)
#   zchg_gossip.c   → zchg_gossip_patched.c  (rename to zchg_gossip.c)
#   zchg_http.c     → zchg_http_patched.c    (rename to zchg_http.c)
# Add to NGINX-HDGL-0.6-c/src/:
#   zchg_lattice_patch.c  (added to Makefile alongside zchg_lattice.c)
# Add to NGINX-HDGL-0.6-c/:
#   hdgl_genome_fabric.h  (symlink or copy from hdgl_router64-0.3/src/)
#   hdgl_genome_fabric.c  (add to Makefile)
#   zchg_carrier.h        (include path)
#
# SEAM 5 — HDGL-SQL bare-metal build
# ─────────────────────────────────────────────────────────────────────────
# For bare-metal: replace zchg_store.c with zchg_store_metal.c in the
# bare-metal build target. The POSIX (daemon) build keeps zchg_store.c.
# Add to bare-metal Makefile:
#   CFLAGS += -DHDGL_BARE_METAL
#   STORE_SRC = zchg_store_metal.c   (instead of zchg_store.c)
#
# SEAM 6 — build.sh: step [8] smoke test
# ─────────────────────────────────────────────────────────────────────────
# Append to build.sh (the emit of smoke_test glyph in hdgl_complete.hdgl):
#
#   echo "[8] Smoke test..."
#   bash smoke_test.sh bin/hdgl_router64.img
